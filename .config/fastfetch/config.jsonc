// ~/.config/fastfetch/config.jsonc
// Layout fofo com imagem sixel das Goticas ♡
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "none"
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "34",
            "title": "35"
        },
        "size": {
            "binaryPrefix": "iec"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "\u001b[1;35m♡\u001b[0m \u001b[1;35m{user-name}\u001b[0m \u001b[90mat\u001b[0m \u001b[1;34m{host-name}\u001b[0m \u001b[1;35m♡\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[90m│\u001b[34m 󰣛 \u001b[0m",
            "keyColor": "blue",
            "format": "{3} {12}"
        },
        {
            "type": "kernel",
            "key": "\u001b[90m│\u001b[34m 󰌽 \u001b[0m",
            "keyColor": "blue",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "\u001b[90m│\u001b[34m 󰅐 \u001b[0m",
            "keyColor": "blue",
            "format": "{2}h {3}m"
        },
        {
            "type": "shell",
            "key": "\u001b[90m│\u001b[36m 󰞷 \u001b[0m",
            "keyColor": "cyan",
            "format": "{1} {4}"
        },
        {
            "type": "wm",
            "key": "\u001b[90m│\u001b[36m 󰍹 \u001b[0m",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[90m│\u001b[36m 󰆍 \u001b[0m",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├──────────────────────────────────────┤\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "\u001b[90m│\u001b[35m 󰻠 \u001b[0m",
            "keyColor": "magenta",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "\u001b[90m│\u001b[35m 󰢮 \u001b[0m",
            "keyColor": "magenta",
            "hideType": "integrated",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "\u001b[90m│\u001b[35m 󰍛 \u001b[0m",
            "keyColor": "magenta",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "\u001b[90m│\u001b[35m 󰋊 \u001b[0m",
            "keyColor": "magenta",
            "format": "{1} / {2} ({3})",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰──────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
