// ~/.config/fastfetch/config.jsonc — minimalista, mascote do Claude
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/claude.txt",
        "color": { "1": "38;2;217;119;87" },
        "padding": { "top": 1, "right": 3 }
    },

    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;217;119;87", "title": "38;2;217;119;87" },
        "size": { "binaryPrefix": "iec" }
    },

    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "os", "key": "os ", "format": "{2}" },
        { "type": "wm", "key": "wm ", "format": "{1}" },
        { "type": "shell", "key": "sh ", "format": "{1}" },
        { "type": "memory", "key": "mem", "format": "{1} / {2}" }
    ]
}
