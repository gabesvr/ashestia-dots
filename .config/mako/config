# Gerado pelo matugen (~/.config/matugen/templates/mako.conf) — não editar aqui.
# Estilo Liquid Glass: vidro escuro translúcido (blur vem do Hyprland, layer "notifications").

font=SF Pro Display 11
width=360
height=160
anchor=top-right
outer-margin=14,14,0,0
margin=0,0,8,0
padding=14,16
border-size=1
border-radius=20
max-icon-size=36
icon-path=/usr/share/icons/WhiteSur-dark:/usr/share/icons/hicolor
icon-location=left
icon-border-radius=10
text-alignment=left
markup=1
format=<span font_desc="SF Pro Rounded Semibold 11">%s</span>\n<span alpha="80%%">%b</span>
max-visible=4
sort=-time
layer=overlay
default-timeout=5000
ignore-timeout=0
group-by=app-name

background-color=#2b2d33e6
text-color=#e4e1e9
border-color=#ffffff1a
progress-color=over #bdc2ff55

# Tema Liquid Glass ligado (modo "glass", ativado pelo GlassTheme.qml do Quickshell):
# vidro claro como os widgets (tint branco 12% sobre o blur do Hyprland).
# No tema sólido / modo gaming o modo sai e vale o cinza #2b2d33 acima.
[mode=glass]
background-color=#ffffff1f
border-color=#ffffff2e
text-color=#ffffff

[grouped]
format=<span font_desc="SF Pro Rounded Semibold 11">%s</span>  <span alpha="55%%">(%g)</span>\n<span alpha="80%%">%b</span>

[urgency=low]
default-timeout=3000

[urgency=critical]
border-color=#ffb4ab
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=dnd]
invisible=1
