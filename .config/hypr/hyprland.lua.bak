-- ============================================================
-- HYPRLAND CONFIGURATION (LUA FORMAT)
-- ============================================================

local f = io.open("/tmp/hypr_lua_debug.txt", "w")
if f then
    f:write("KEYS IN hl.plugin.hyprglass:\n")
    if hl and hl.plugin and hl.plugin.hyprglass then
        for k, v in pairs(hl.plugin.hyprglass) do
            f:write("  " .. tostring(k) .. " = " .. tostring(v) .. "\n")
        end
    end
    f:close()
end

